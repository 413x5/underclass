#!/bin/sh
# post-commit — advisory only: warn when the commit just made was NOT covered by the hook.
#
# Copy into the repo's .githooks/ and enable once per clone with a RELATIVE path:
#
#   git config core.hooksPath .githooks
#
# Relative, because an absolute path breaks git worktrees: every worktree would run the hooks of
# whichever checkout the path names instead of its own.
#
# This file is a SHIM: it resolves the installed helper and execs it, exactly as pre-commit does. The logic
# lives in `preflight-advisory`, so a fix ships once via install.sh instead of being propagated to every
# repository that committed a copy - which was a real defect twice.
#
# PREFLIGHT_SKIP=1 silences it. A missing helper is silent here rather than fatal: pre-commit already
# fails closed without one, so the commit cannot reach this hook in that state, and a post-commit hook
# that refused would only turn a missing install into a failed commit after the fact.
set -u

helper="${PREFLIGHT_ADVISORY:-${HOME:-}/.config/preflight/preflight-advisory}"
[ -x "$helper" ] || exit 0

exec "$helper"
